{
  "name": "speedrun",
  "version": "0.3.0",
  "description": "Speedrun your day: an open-source, local-first tracker that splits your computer time into tasks.",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "npm run build && electron .",
    "test": "npm run build && node --test dist/*.test.js",
    "dist": "npm run build && electron-builder --mac --publish never",
    "release": "npm run build && electron-builder --mac --publish always"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "^44.7.0",
    "typescript": "^5.9.0",
    "electron-builder": "^26.0.0"
  },
  "productName": "Speedrun",
  "author": "Roland",
  "build": {
    "appId": "com.frontier0x.speedrun",
    "productName": "Speedrun",
    "copyright": "MIT",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/**/*.test.js",
      "!dist/**/*.map",
      "static/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Speedrun asks your browser for the current tab’s address, so it can tell work from distractions. Nothing leaves your Mac."
      }
    },
    "dmg": {
      "title": "Speedrun"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "frontier0x",
        "repo": "speedrun",
        "releaseType": "release"
      }
    ],
    "npmRebuild": false
  }
}
